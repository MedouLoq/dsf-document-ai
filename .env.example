# ── Gemini: choose ONE backend ─────────────────────────────────
# Option A — Vertex AI with a service account (recommended)
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Option B — Gemini API key (leave GCP_PROJECT_ID empty)
GEMINI_API_KEY=

GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SEC=90
GEMINI_CALL_DELAY_SEC=1.5

# ── Optional: Document AI Form Parser (handwritten forms) ──────
DOCAI_PROCESSOR_ID=
DOCAI_LOCATION=us

# ── Web app ────────────────────────────────────────────────────
FLASK_SECRET_KEY=generate-with-python-c-import-secrets-print-secrets.token_hex-32
UPLOAD_FOLDER=uploads
OUTPUT_FOLDER=outputs
MAX_CONTENT_LENGTH=104857600
PDF_DPI=200
HOST=127.0.0.1
PORT=5000
DEBUG=false

# Serve synthetic results without calling Google Cloud
DEMO_MODE=false
